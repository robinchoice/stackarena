# Install: systemctl --user link orchestrator/stackarena-night.{service,timer}
#          systemctl --user enable --now stackarena-night.timer
[Unit]
Description=Stackarena night runs, start window 21:00 to 00:00

[Timer]
OnCalendar=*-*-* 21,22,23:00,15,30,45
OnCalendar=*-*-* 00:00

[Install]
WantedBy=timers.target
